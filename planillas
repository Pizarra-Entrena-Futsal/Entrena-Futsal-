<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recursos & Planillas - @entrenafutsal</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: #121212; color: #fff; padding: 16px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }

    header { width: 100%; max-width: 960px; display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: #1e1e1e; border-radius: 10px; border-bottom: 3px solid #00e676; margin-bottom: 20px; }
    .header-info { display: flex; align-items: center; gap: 12px; }
    .header-logo { width: 44px; height: 44px; border-radius: 50%; border: 2px solid #00e676; }
    .header-text strong { font-size: 18px; color: #fff; display: block; }
    .header-text span { color: #00e676; font-weight: bold; font-size: 14px; }
    
    .nav-links { display: flex; gap: 8px; }
    .nav-link { background: #333; color: #fff; text-decoration: none; padding: 8px 12px; border-radius: 6px; font-weight: bold; font-size: 12px; }
    .nav-link:hover { background: #444; }

    .main-container { width: 100%; max-width: 960px; }
    .section-title { font-size: 20px; color: #00e676; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }

    .grid-planillas { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .card { background: #1e1e1e; border: 1px solid #333; border-radius: 12px; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s; }
    .card:hover { transform: translateY(-4px); border-color: #00e676; }

    .card-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 4px 8px; border-radius: 4px; width: fit-content; margin-bottom: 8px; }
    .tag-free { background: rgba(0,230,118,0.2); color: #00e676; border: 1px solid #00e676; }
    .tag-pro { background: rgba(255,152,0,0.2); color: #ff9800; border: 1px solid #ff9800; }

    .card-title { font-size: 16px; font-weight: bold; margin-bottom: 6px; color: #fff; }
    .card-desc { font-size: 12px; color: #aaa; margin-bottom: 14px; line-height: 1.4; }
    .card-price { font-size: 18px; font-weight: 900; color: #00e676; margin-bottom: 12px; }

    .btn-action { width: 100%; padding: 10px; border: none; border-radius: 6px; font-weight: bold; font-size: 13px; cursor: pointer; text-align: center; text-decoration: none; display: block; }
    .btn-free { background: #00e676; color: #121212; }
    .btn-pay { background: #ff9800; color: #121212; }
  </style>
</head>
<body>

  <header>
    <div class="header-info">
      <img src="logo.png.jpg" alt="Logo" class="header-logo" onerror="this.src='logo.png'; this.onerror=null;">
      <div class="header-text">
        <strong>Recursos & Planillas</strong>
        <span>@entrenafutsal</span>
      </div>
    </div>
    <div class="nav-links">
      <a href="index.html" class="nav-link">📋 Pizarra</a>
      <a href="analisis.html" class="nav-link">🎥 Video</a>
      <a href="stats.html" class="nav-link">📊 Stats</a>
    </div>
  </header>

  <div class="main-container">
    <div class="section-title">📁 Descargas Disponibles para Cuerpo Técnico</div>

    <div class="grid-planillas">
      <!-- PLANILLA GRATIS -->
      <div class="card">
        <div>
          <span class="card-tag tag-free">GRATIS</span>
          <div class="card-title">Planilla de Control de Partido</div>
          <div class="card-desc">Formato PDF A4 listo para imprimir. Control de quintetos, faltas acumuladas, tiempo muerto y notas tácticas.</div>
        </div>
        <div>
          <div class="card-price">GRATIS</div>
          <a href="planillas/planilla-partido.pdf" download class="btn-action btn-free">📥 Descargar PDF</a>
        </div>
      </div>

      <!-- PLANILLA PAGA 1 -->
      <div class="card">
        <div>
          <span class="card-tag tag-pro">PRO EXCEL</span>
          <div class="card-title">Planificador de Microciclo</div>
          <div class="card-desc">Excel interactivo con cálculo automático de minutos de entrenamiento, cargas y distribución semanal.</div>
        </div>
        <div>
          <div class="card-price">$4.500 ARS</div>
          <!-- Reemplazar el href con tu Link de Mercado Pago o DropyFile -->
          <a href="https://mpago.la/tu-link-de-pago" target="_blank" class="btn-action btn-pay">💳 Comprar y Descargar</a>
        </div>
      </div>

      <!-- PLANILLA PAGA 2 -->
      <div class="card">
        <div>
          <span class="card-tag tag-pro">PACK COMPLETO</span>
          <div class="card-title">Kit Completo del Entrenador</div>
          <div class="card-desc">Incluye Scouting Rival, Control de Cargas RPE, Microciclo y 5 modelos de informes de partido.</div>
        </div>
        <div>
          <div class="card-price">$12.000 ARS</div>
          <a href="https://mpago.la/tu-link-pack" target="_blank" class="btn-action btn-pay">⚡ Obtener Pack Completo</a>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
